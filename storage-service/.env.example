# ─────────────────────────────────────────────────────────────────────────────
# Storage Service – Environment Variable Reference
# Copy this file to .env and fill in the values for your environment.
# Never commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="Storage Service"
APP_VERSION="1.0.0"
ENVIRONMENT=development          # development | staging | production
DEBUG=false
SECRET_KEY=change-me-use-a-long-random-string

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1
RELOAD=false

# ── Storage backend selection ─────────────────────────────────────────────────
# Choose ONE: s3 | gcs | minio
STORAGE_BACKEND=minio

MAX_UPLOAD_SIZE_MB=500

# ── Amazon S3 (set when STORAGE_BACKEND=s3) ───────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=my-storage-bucket
# S3_ENDPOINT_URL=http://localhost:4566  # uncomment for LocalStack

# ── Google Cloud Storage (set when STORAGE_BACKEND=gcs) ──────────────────────
GCS_BUCKET=my-gcs-bucket
GCS_CREDENTIALS_JSON=/path/to/service-account.json
GCS_PROJECT_ID=my-gcp-project

# ── MinIO (set when STORAGE_BACKEND=minio) ────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=storage-service
MINIO_SECURE=false

# ── Image processing ──────────────────────────────────────────────────────────
IMAGEMAGICK_BINARY=convert
IMAGE_MAX_WIDTH=4096
IMAGE_MAX_HEIGHT=4096
IMAGE_THUMBNAIL_WIDTH=256
IMAGE_THUMBNAIL_HEIGHT=256
IMAGE_QUALITY=85

# ── Video processing ──────────────────────────────────────────────────────────
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
VIDEO_MAX_DURATION_SECONDS=3600
VIDEO_THUMBNAIL_TIME_OFFSET=00:00:05

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json              # json | text

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["*"]           # restrict in production, e.g. ["https://app.example.com"]
CORS_ALLOW_CREDENTIALS=true

# ── Auth (placeholder) ────────────────────────────────────────────────────────
AUTH_ENABLED=false
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
