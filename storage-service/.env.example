# =============================================================================
# Application
# =============================================================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# =============================================================================
# Storage Provider (s3 | gcs | minio)
# =============================================================================
STORAGE_PROVIDER=s3
DEFAULT_BUCKET=storage-service-bucket

# =============================================================================
# AWS S3 Configuration
# =============================================================================
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name
AWS_S3_ENDPOINT=                           # Optional: custom endpoint for S3-compatible APIs

# =============================================================================
# Google Cloud Storage Configuration
# =============================================================================
GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=your-gcs-bucket-name
GCS_KEY_FILE=./credentials/gcs-service-account.json   # Path to service account JSON

# =============================================================================
# MinIO Configuration
# =============================================================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=storage-service
MINIO_USE_SSL=false

# =============================================================================
# File Upload Limits
# =============================================================================
MAX_FILE_SIZE_MB=100
MAX_IMAGE_SIZE_MB=20
MAX_VIDEO_SIZE_MB=500
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp,image/tiff
ALLOWED_VIDEO_TYPES=video/mp4,video/mpeg,video/quicktime,video/x-msvideo,video/webm
ALLOWED_DOCUMENT_TYPES=application/pdf,text/plain,application/msword

# =============================================================================
# Media Processing
# =============================================================================
IMAGE_THUMBNAIL_WIDTH=320
IMAGE_THUMBNAIL_HEIGHT=240
IMAGE_QUALITY=85
VIDEO_OUTPUT_FORMAT=mp4
VIDEO_OUTPUT_CODEC=libx264
VIDEO_OUTPUT_AUDIO_CODEC=aac
FFMPEG_PATH=/usr/bin/ffmpeg
IMAGEMAGICK_PATH=/usr/bin/convert

# =============================================================================
# Presigned URL TTL
# =============================================================================
PRESIGNED_URL_TTL_SECONDS=3600

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# Authentication (placeholder — plug in your auth provider)
# =============================================================================
AUTH_ENABLED=false
JWT_SECRET=change_this_to_a_secure_random_value
JWT_EXPIRY=1h
