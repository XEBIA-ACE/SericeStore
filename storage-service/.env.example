# =============================================================================
# SericeStore — environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=SericeStore
APP_VERSION=1.0.0
ENVIRONMENT=development          # development | staging | production
DEBUG=false
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
WORKERS=4
ALLOWED_ORIGINS=*                # Comma-separated list or * for all

# ---------------------------------------------------------------------------
# Storage backend selection
# ---------------------------------------------------------------------------
STORAGE_BACKEND=minio            # s3 | gcs | minio

# ---------------------------------------------------------------------------
# Amazon S3 (STORAGE_BACKEND=s3)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=sericestore
# AWS_S3_ENDPOINT_URL=           # Optional custom endpoint (e.g. LocalStack)

# ---------------------------------------------------------------------------
# Google Cloud Storage (STORAGE_BACKEND=gcs)
# ---------------------------------------------------------------------------
GCS_PROJECT_ID=
GCS_BUCKET=sericestore
# GCS_CREDENTIALS_FILE=          # Path to service account JSON (optional)

# ---------------------------------------------------------------------------
# MinIO (STORAGE_BACKEND=minio)
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sericestore
MINIO_SECURE=false               # true for TLS-enabled MinIO

# ---------------------------------------------------------------------------
# File handling
# ---------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=500
TEMP_DIR=/tmp/sericestore
PRESIGNED_URL_EXPIRY=3600        # seconds

# ---------------------------------------------------------------------------
# ImageMagick
# ---------------------------------------------------------------------------
IMAGEMAGICK_CONVERT_PATH=convert
IMAGEMAGICK_IDENTIFY_PATH=identify
IMAGE_QUALITY_DEFAULT=85
THUMBNAIL_WIDTH=300
THUMBNAIL_HEIGHT=300

# ---------------------------------------------------------------------------
# FFmpeg
# ---------------------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIDEO_CRF_DEFAULT=23
VIDEO_PRESET_DEFAULT=medium
AUDIO_BITRATE_DEFAULT=128k

# ---------------------------------------------------------------------------
# Authentication (placeholder)
# ---------------------------------------------------------------------------
AUTH_ENABLED=false
AUTH_SECRET_KEY=change-me-in-production
AUTH_ALGORITHM=HS256
AUTH_TOKEN_EXPIRE_MINUTES=60
