# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SERVICE_NAME=storage-service

# ─────────────────────────────────────────────
# Storage Backend (s3 | gcs | minio)
# ─────────────────────────────────────────────
STORAGE_PROVIDER=minio

# ─────────────────────────────────────────────
# Amazon S3
# ─────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET=your-bucket-name
AWS_S3_ENDPOINT=                          # optional: custom endpoint (e.g. LocalStack)

# ─────────────────────────────────────────────
# Google Cloud Storage
# ─────────────────────────────────────────────
GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=your-gcs-bucket-name
GCS_KEY_FILE=./config/gcs-key.json       # path to service-account JSON
# Or inline JSON (base64):
# GCS_CREDENTIALS_BASE64=

# ─────────────────────────────────────────────
# MinIO
# ─────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=storage-service

# ─────────────────────────────────────────────
# File Upload Limits
# ─────────────────────────────────────────────
MAX_FILE_SIZE_MB=100
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp,image/tiff,image/bmp
ALLOWED_VIDEO_TYPES=video/mp4,video/mpeg,video/quicktime,video/x-msvideo,video/webm
ALLOWED_DOCUMENT_TYPES=application/pdf,text/plain,application/json

# ─────────────────────────────────────────────
# Image Processing (ImageMagick / gm)
# ─────────────────────────────────────────────
IMAGE_MAGICK_PATH=/usr/bin/convert       # path to ImageMagick convert binary
DEFAULT_IMAGE_QUALITY=85
THUMBNAIL_WIDTH=200
THUMBNAIL_HEIGHT=200
ENABLE_IMAGE_PROCESSING=true

# ─────────────────────────────────────────────
# Video Processing (FFmpeg)
# ─────────────────────────────────────────────
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
ENABLE_VIDEO_PROCESSING=true
VIDEO_THUMBNAIL_SECOND=5               # second at which to capture thumbnail

# ─────────────────────────────────────────────
# Authentication (JWT)
# ─────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-a-strong-secret
JWT_EXPIRY=1h
AUTH_ENABLED=true

# ─────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ─────────────────────────────────────────────
# Presigned URL TTL (seconds)
# ─────────────────────────────────────────────
PRESIGNED_URL_TTL=3600

# ─────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3001,http://localhost:4000
